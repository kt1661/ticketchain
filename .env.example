# Copy to .env and fill in. NEVER commit the real .env.

# RPC endpoint for Sepolia (Alchemy/Infura free tier)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer private key (use a throwaway dev wallet, never your main one).
# This account also acts as the event organizer in the demo scripts.
WALLET_ADDRESS=0xyourdeployeraddress
PRIVATE_KEY=0xyourprivatekey

# For contract verification on Etherscan
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Throwaway demo actors for the testnet scenario scripts (generate with
# `cast wallet new`; funded from the deployer wallet above by
# script/00_FundActors.s.sol — never use real funds for these).
ALICE_ADDRESS=0xyouralicedemoaddress
ALICE_PRIVATE_KEY=0xyouralicedemokey
BOB_ADDRESS=0xyourbobdemoaddress
BOB_PRIVATE_KEY=0xyourbobdemokey
